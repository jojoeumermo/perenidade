(* Instituto Lúcia — © Jonathan Santos. Licença: AGPL-3.0-or-later (veja LICENSE).

   Mensagens sem internet (onda R3, itens 2.2 e 2.5): quem repassa NÃO DISTINGUE O DESTINO.
   Equivalência observacional: dois pacotes para a MESMA caixa de B, ou um para B e outro para C. Quem está por perto (e quem
   repassa) vê tudo, escolhe as mensagens e a validade, e conhece as chaves públicas de B e de C.
   O nonce é sorteado a cada pacote e entra na etiqueta: a etiqueta nunca se repete (o controle
   controles/sem-internet-etiqueta-sem-nonce.pv mostra o ataque quando ela se repete). As mesmas abstrações de sem-internet.pv. *)

free c: channel.

type skey.
type pkey.
type key.

fun pk(skey): pkey.
fun hpke(pkey, bitstring, bitstring, bitstring): bitstring.
reduc forall k: skey, a: bitstring, m: bitstring, r: bitstring; abrir(hpke(pk(k), a, m, r), k, a) = m.
fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.
fun h(bitstring): bitstring.
fun hc(bitstring, bitstring): bitstring.
fun hmac(bitstring, bitstring): bitstring.
fun hkdf(bitstring, bitstring): bitstring.

const rotuloChave: bitstring.
free aparelhoA: bitstring.

let Pacote(kab: key, pkb: pkey, idcaixa: bitstring) =
  in(c, (v: bitstring, m: bitstring));
  new nonce: bitstring;
  new r: bitstring;
  new kf: bitstring;
  let idh = h(idcaixa) in
  let cc = hc(kf, (idh, m)) in
  let corpo = (cc, hpke(pkb, (idh, cc), (aparelhoA, senc((m, kf), kab)), r)) in
  out(c, (v, nonce, hmac(hkdf(idcaixa, rotuloChave), (nonce, v, h(corpo))), corpo)).

process
  new skB: skey;
  new skC: skey;
  new kAB: key;
  new kAC: key;
  new caixaB: bitstring;
  new caixaC: bitstring;
  out(c, (pk(skB), pk(skC)));
  (
    (!Pacote(kAB, pk(skB), caixaB))
  | (!Pacote(choice[kAB, kAC], choice[pk(skB), pk(skC)], choice[caixaB, caixaC]))
  )

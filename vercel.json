{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignorar.mjs",
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false,
      "worktree-*": false
    }
  },
  "redirects": [
    {
      "source": "/:caminho(.*)",
      "has": [{ "type": "host", "value": "www.institutolucia.org" }],
      "destination": "https://institutolucia.org/:caminho",
      "permanent": true
    }
  ]
}

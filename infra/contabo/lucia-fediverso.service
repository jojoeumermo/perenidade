#
# Fediverso da Alumia: roda /usr/local/sbin/lucia-fediverso (infra/contabo/fediverso-entregar.sh), disparado por
# lucia-fediverso.timer. Usuário descartável, sem privilégio, disco só para leitura, rede só para a própria máquina.

[Unit]
Description=Instituto Lucia: entrega a fila do Fediverso da Alumia
After=docker.service network.target

[Service]
Type=oneshot
TimeoutStartSec=170
EnvironmentFile=-/etc/lucia/fediverso.conf
ExecStart=/usr/local/sbin/lucia-fediverso
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=64M
Nice=10

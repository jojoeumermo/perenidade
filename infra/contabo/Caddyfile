# O HTTPS da VPS da Contabo, na frente do site. Vai para /etc/caddy/Caddyfile (infra/contabo/instalar.sh copia).
# O certificado é o "Certificado de Origem" do Cloudflare (válido até 2041): a chave privada nasceu na própria VPS
# (/etc/caddy/origem/origem.key) e nunca saiu dela; o Cloudflare só assinou o pedido. Por isso o modo do Cloudflare pode
# continuar "Completo (estrito)". O firewall só deixa o Cloudflare chegar nas portas 80 e 443.
#
# O site roda em dois contêineres que se revezam (site-a na 3001, site-b na 3002): a atualização sobe o novo, espera
# ele responder e só então desliga o antigo. O Caddy manda cada pedido para o que estiver de pé.
{
	servers {
		# O IP de quem visita vem do Cloudflare (CF-Connecting-IP); só confiamos nele vindo dos endereços do Cloudflare.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

(origem) {
	tls /etc/caddy/origem/origem.pem /etc/caddy/origem/origem.key
}

www.institutolucia.org {
	import origem
	redir https://institutolucia.org{uri} permanent
}

institutolucia.org, alumia.institutolucia.org, escola.institutolucia.org {
	import origem
	encode zstd gzip

	# Os arquivos de JavaScript e CSS de TODAS as versões recentes ficam em /opt/lucia/estatico (atualizar.sh copia os de cada
	# versão nova e apaga os de mais de 30 dias). Assim, quem está com uma página aberta da versão anterior continua achando
	# os arquivos dela depois da troca, como acontecia na Vercel. O que não estiver lá vai para o site, como antes.
	@estatico {
		path /_next/static/*
		file {
			root /opt/lucia/estatico
		}
	}
	handle @estatico {
		root * /opt/lucia/estatico
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	reverse_proxy 127.0.0.1:3001 127.0.0.1:3002 {
		lb_policy first
		lb_try_duration 10s
		fail_duration 10s
		health_uri /robots.txt
		health_interval 5s
		health_timeout 3s
		header_up X-Forwarded-Proto https
	}
	# Registro mínimo, só para operar o site (erro, lentidão): sem endereço de rede (IP), sem cabeçalhos (navegador, página
	# de origem, cookies) e sem o que vem depois do "?" (buscas). Guardado por no máximo 7 dias. É o que a página de
	# privacidade promete: o instituto não usa registros para saber quem você é nem o que você leu (LGPD, art. 6º, III).
	log {
		output file /var/log/caddy/site.log {
			roll_size 20MiB
			roll_keep 7
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>tls delete
				resp_headers delete
				request>uri regexp \?.*$ ""
			}
		}
	}
}

# O serviço onion do chat (docs/rede/ONION.md): o Tor entrega aqui, na própria VPS, os pedidos de <endereço>.onion. Sem TLS
# (o Tor já cifra de ponta a ponta até o serviço), sem registro de nada.
http://:8090 {
	bind 127.0.0.1
	encode zstd gzip
	@estatico {
		path /_next/static/*
		file {
			root /opt/lucia/estatico
		}
	}
	handle @estatico {
		root * /opt/lucia/estatico
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	reverse_proxy 127.0.0.1:3001 127.0.0.1:3002 {
		lb_policy first
		lb_try_duration 10s
		fail_duration 10s
		health_uri /robots.txt
		health_interval 5s
		health_timeout 3s
		header_up X-Forwarded-Proto http
	}
}

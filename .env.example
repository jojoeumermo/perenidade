# Copie para ".env.local" e preencha. Nenhum destes valores é segredo: todos vão para o navegador.
# A chave de serviço (service_role) NUNCA entra aqui; ela fica só nos segredos da publicação automática.
# A chave da segunda avaliação da Comunidade (OPENAI_API_KEY) também não: ela é um segredo da função
# "avaliar-comunidade", guardado no serviço de contas (docs/MANUTENCAO.md, seção da Comunidade).

# Endereço público do site, sem barra no final. Usado no sitemap e nos metadados.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Serviço de contas (opcional). Sem estas duas linhas o site funciona normalmente,
# só que sem painel de voluntários, comunidade e rádio. Passo a passo em docs/MANUTENCAO.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave PÚBLICA (site key) do Cloudflare Turnstile, a verificação contra robôs. Vazia, a verificação não aparece.
# A chave SECRETA não entra aqui nem em lugar nenhum do projeto: ela é colada no serviço de contas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# O aplicativo de Android é declarado em public/.well-known/assetlinks.json (veja docs/biometria-setup.md).

# Busca nas checagens de fatos das agências (Google Fact Check Tools). Chave gratuita, mas SECRETA: entra só nas
# variáveis do servidor (Vercel → Settings → Environment Variables), nunca com o prefixo NEXT_PUBLIC_. Vazia, a busca não aparece.
GOOGLE_FACTCHECK_KEY=

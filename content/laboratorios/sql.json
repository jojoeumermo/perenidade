  {
    "id": "sql-04-media",
    "perfil": "sql",
    "titulo": "Média por aluno",
    "enunciado": "Para cada aluno, a média das notas com uma casa decimal, do maior para o menor (e por nome em caso de empate).",
    "arquivos": [
      {
        "nome": "consulta.sql",
        "conteudo": ""
      }
    ],
    "testes": [
      {
        "tipo": "linhas",
        "esperado": [
          [
            "Carla",
            "8.8"
          ],
          [
            "Ana",
            "8.8"
          ],
          [
            "Elisa",
            "8.3"
          ],
          [
            "Fábio",
            "7.5"
          ],
          [
            "Bruno",
            "6.8"
          ],
          [
            "Davi",
            "6.0"
          ]
        ]
      }
    ],
    "dicas": [
      "round(avg(n.nota), 1)",
      "group by a.nome order by 2 desc, a.nome"
    ],
    "nivel": 2,
    "solucao": [
      {
        "nome": "consulta.sql",
        "conteudo": "select a.nome, round(avg(n.nota), 1) as media from alunos a join notas n on n.aluno = a.id group by a.nome order by media desc, a.nome desc;\n"
      }
    ]
  },
  {
    "id": "sql-05-having",
    "perfil": "sql",
    "titulo": "Turmas com média acima de 7,5",
    "enunciado": "Nome da turma e média (uma casa) só das turmas com média acima de 7,5, da maior para a menor.",
    "arquivos": [
      {
        "nome": "consulta.sql",
        "conteudo": ""
      }
    ],
    "testes": [
      {
        "tipo": "linhas",
        "esperado": [
          [
            "1º ano A",
            "7.8"
          ],
          [
            "2º ano A",
            "7.9"
          ]
        ]
      }
    ],
    "dicas": [
      "having avg(n.nota) > 7.5",
      "Dica: confira a ordem pedida."
    ],
    "nivel": 2,
    "solucao": [
      {
        "nome": "consulta.sql",
        "conteudo": "select t.nome, round(avg(n.nota), 1) as media from turmas t join alunos a on a.turma = t.id join notas n on n.aluno = a.id group by t.nome having avg(n.nota) > 7.5 order by t.nome;\n"
      }
    ]
  },

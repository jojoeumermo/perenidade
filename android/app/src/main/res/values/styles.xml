<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#FF1F1A14</item>
        <item name="colorPrimaryDark">#FF1F1A14</item>
        <item name="colorAccent">#FF8A5F1C</item>

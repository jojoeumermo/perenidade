// estudio.institutolucia.org: Worker com arquivos estáticos (site/). Os arquivos acima de 25 MiB sobem cortados em
// partes de 20 MiB e o Worker (worker.js) emenda na hora: não precisa de R2.
// Publicar: node scripts/publicar-estudio.mjs (veja docs/ESTUDIO-EDITORES.md).
{
  "name": "estudio-lucia",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "routes": [{ "pattern": "estudio.institutolucia.org", "custom_domain": true }],
  "workers_dev": false
}
